name: Copy context.md to Destination

on:
  push:
    branches:
      - main
    paths:
      - 'context.md' # Triggers ONLY when context.md is changed

jobs:
  copy-file:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source Repo
        uses: actions/checkout@v4

      - name: Clone Destination Repo & Copy File
        env:
          # Uses the Fine-Grained token you saved in your Source Repo secrets
          DEST_TOKEN: ${{ secrets.MY_DESTINATION_TOKEN }} 
        run: |
          # 1. Set up Git identity for the commit
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@://github.com"
          
          # 2. Clone your newly created destination repository
          # Change 'your-username' and 'newly-created-repo-name' to match your Github details
          git clone https://x-token-auth:${DEST_TOKEN}@://github.com dest_repo
          
          # 3. Copy context.md from your source into the cloned destination folder
          # Change 'repo-1-context.md' if you want a different name so your 3 repos don't conflict
          cp context.md dest_repo/repo-1-context.md
          
          # 4. Navigate into the destination repository to commit and push
          cd dest_repo
          git add repo-1-context.md
          
          # Only commit and push if the file contents have actually changed
          if git diff --cached --quiet; then
            echo "No changes detected in context.md. Skipping push."
          else
            git commit -m "Automated update of context.md from Source Repo"
            git push origin main
          fi
