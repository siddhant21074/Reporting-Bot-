# ============================================================================
#  SiteReport Bot -- environment template
#  Copy to .env and fill in. Every name here matches a field in
#  app/core/config.py; anything set on the admin Settings page overrides it.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_NAME="SiteReport Bot"
APP_VERSION="0.2.0"
# development | staging | production
# Outside development, SECRET_KEY and WHATSAPP_APP_SECRET become mandatory.
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=false
# Public HTTPS URL of this service. Used to build the webhook URLs you paste
# into the Meta and Telegram dashboards.
BASE_URL="https://reports.example.com"

# --- Database ---------------------------------------------------------------
# DigitalOcean Managed Postgres: copy the connection string from the control
# panel and change the scheme to postgresql+asyncpg://
DATABASE_URL="sqlite+aiosqlite:///storage/app.db"
# Optional. Leave blank unless you have a Redis instance.
REDIS_URL=""

# --- Retention & sessions ---------------------------------------------------
# Messages, reports and downloaded media older than this are purged.
RETENTION_DAYS=7
# Idle time before an in-flight report conversation resets, in seconds.
SESSION_TIMEOUT_SECONDS=1800

# --- Admin dashboard --------------------------------------------------------
ADMIN_USERNAME="admin"
# bcrypt hash, NOT the password. Generate one with:
#   python scripts/make_admin.py
ADMIN_PASSWORD_HASH=""
# Signs the admin session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ADMIN_SESSION_MAX_AGE=28800

# ============================================================================
#  CHANNELS -- at least one must be configured
# ============================================================================

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# Webhook URL to register in the Meta dashboard: {BASE_URL}/webhook/whatsapp
WHATSAPP_ENABLED=true
WHATSAPP_APP_ID=""
# App secret from Meta > App Settings > Basic. Authenticates every incoming
# webhook; the app refuses to process webhooks without it in production.
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_PHONE_NUMBER=""
# Any string you choose; paste the same value into the Meta webhook setup form.
WHATSAPP_VERIFY_TOKEN=""
META_API_VERSION="v21.0"

# --- Telegram ---------------------------------------------------------------
# Webhook URL to register: {BASE_URL}/webhook/telegram
TELEGRAM_ENABLED=false
# From @BotFather.
TELEGRAM_BOT_TOKEN=""
# Any string you choose. Telegram echoes it in X-Telegram-Bot-Api-Secret-Token,
# which is how incoming updates are authenticated.
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_API_BASE_URL="https://api.telegram.org"

# ============================================================================
#  AI -- chat and speech-to-text are configured independently
#  Providers, models and free-tier notes: app/ai/registry.py
# ============================================================================

# --- Chat / report structuring ----------------------------------------------
# openai | openrouter | groq | together | deepinfra | ollama | custom
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
# Only for LLM_PROVIDER=custom, or to override a known provider's endpoint.
LLM_BASE_URL=""
LLM_TIMEOUT=60

# Free options:
#   LLM_PROVIDER="groq"        LLM_MODEL="llama-3.3-70b-versatile"
#   LLM_PROVIDER="openrouter"  LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"
#   LLM_PROVIDER="ollama"      LLM_MODEL="llama3.1"     (self-hosted, no key)

# --- Speech-to-text ---------------------------------------------------------
# auto | openai | groq | deepinfra | faster-whisper | sphinx | google-web | custom
#
# You do not have to configure this at all. If the chosen provider has no API
# key -- or its library is not installed -- transcription automatically falls
# back to a built-in Python engine, best available first:
#     faster-whisper  ->  pocketsphinx  ->  Google Web Speech
# The dashboard's System status panel shows which one is actually in use.
STT_PROVIDER="openai"
STT_MODEL="whisper-1"
# Leave blank to reuse LLM_API_KEY when both use the same provider.
STT_API_KEY=""
STT_BASE_URL=""
STT_TIMEOUT=120
# ISO hint, e.g. "en" or "hi". Blank means auto-detect.
STT_LANGUAGE=""

# No-key options:
#   STT_PROVIDER="auto"                       use the best installed library
#   STT_PROVIDER="faster-whisper"  STT_MODEL="base"   offline, accurate
#                                    (uncomment faster-whisper in requirements.txt)
#   STT_PROVIDER="sphinx"                     offline, tiny, English only
#                                    (uncomment pocketsphinx in requirements.txt)
# Free but key-based, and more accurate than any of the above:
#   STT_PROVIDER="groq"            STT_MODEL="whisper-large-v3"

# --- Storage paths ----------------------------------------------------------
LOG_STORAGE_PATH="storage/logs"
MEDIA_STORAGE_PATH="storage/media"
REPORT_STORAGE_PATH="storage/reports"
STORAGE_TEMP_DIR="storage/temp"
# Drop a .ttf here to control PDF typography. Without a Unicode font, non-Latin
# text in PDFs is transliterated.
FONTS_DIR="storage/fonts"

# --- Outbound HTTP ----------------------------------------------------------
HTTP_TIMEOUT=30
HTTP_RETRY_COUNT=3
